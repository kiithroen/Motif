{
  "name": "motif",
  "private": true,
  "version": "1.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cmd /c \"cd android && gradlew.bat assembleDebug\"",
    "android:release": "npm run android:sync && cmd /c \"cd android && gradlew.bat assembleRelease bundleRelease\""
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@types/node": "^22.10.0",
    "happy-dom": "^17.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "smplr": "^1.2.1"
  }
}
